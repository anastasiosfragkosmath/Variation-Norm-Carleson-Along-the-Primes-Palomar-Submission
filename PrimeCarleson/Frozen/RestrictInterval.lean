/-!
# Frozen: `PrimeCarleson.restrictInterval`

The definition as the author approved it before any proof used it; it is the only
declaration in this file.
-/

@[expose] public noncomputable section

open MeasureTheory Filter Topology
open scoped ENNReal ComplexConjugate

set_option autoImplicit false

namespace PrimeCarleson

/-- The extension by zero of `g` restricted to `[N] = {1, …, N}`. -/
def restrictInterval (N : ℕ+) (g : ℤ → ℂ) : ℤ →₀ ℂ :=
  Finsupp.indicator (Finset.Icc (1 : ℤ) N) (fun n _ => g n)

end PrimeCarleson
