module

public import PrimeCarleson.Proof.Lepingle.Prob.Martingale
public import PrimeCarleson.Proof.Lepingle.Prob.Lepingle
public import PrimeCarleson.Proof.Lepingle.Prob.DoobLp
public import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
public import Mathlib.MeasureTheory.Integral.Bochner.Set
public import Mathlib.Algebra.Order.Floor.Ring
public import Mathlib.MeasureTheory.Function.Floor

/-!
# The dyadic filtration on `ℝ` and the dyadic averages

Definitions and the averaging formula for the dyadic martingale.  Source: Zorin-Kranich's notes
(00-background.tex, L84–L90; L60-L66 for item (8) of the properties of conditional expectation).

* `dyadicIdx k x = ⌊x / 2^k⌋`, `dyadicIco k m = [2^k m, 2^k (m+1))`
  (`mem_dyadicIco_iff : x ∈ I_{k,m} ↔ dyadicIdx k x = m`);
* `dyadicAvg f k x = 2^{-k} ∫_{I_k(x)} f` (the dyadic average `E_k[f](x)` of `[O+]`);
* `dyadicSigma k`: the `σ`-algebra generated by the dyadic intervals of length `2^k`; it gets
  finer as `k` decreases (`dyadicSigma_mono`);
* `dyadicFiltration N L`: the filtration `n ↦ dyadicSigma (N - min n L)` of the time
  reversed, constant-padded dyadic scales `N, N-1, …, N-L, N-L, …`;
* `setIntegral_dyadicAvg`: for a scale `k ≤ N`, a dyadic interval `B` of length `2^N` and `T ⊆ ℤ`,
  `∫_{B ∩ {idx_k ∈ T}} E_k f = ∫_{B ∩ {idx_k ∈ T}} f` (averaging on the atoms).
-/

@[expose] public noncomputable section

open MeasureTheory Set Filter Finset
open scoped ENNReal

set_option autoImplicit false

namespace PrimeCarleson.Proof.Lepingle

/-- The index `⌊x / 2^k⌋` of the dyadic interval of length `2^k` containing `x`. -/
def dyadicIdx (k : ℤ) (x : ℝ) : ℤ := ⌊x / (2 : ℝ) ^ k⌋

/-- The dyadic interval `I_{k,m} = [2^k m, 2^k (m+1))`. -/
def dyadicIco (k m : ℤ) : Set ℝ := Ico ((2 : ℝ) ^ k * m) ((2 : ℝ) ^ k * (m + 1))

theorem mem_dyadicIco_iff {k m : ℤ} {x : ℝ} : x ∈ dyadicIco k m ↔ dyadicIdx k x = m := by
  have h2 : (0 : ℝ) < (2 : ℝ) ^ k := zpow_pos (by norm_num) k
  unfold dyadicIco dyadicIdx
  rw [Int.floor_eq_iff, Set.mem_Ico, le_div_iff₀ h2, div_lt_iff₀ h2, mul_comm (m : ℝ),
    mul_comm (↑m + 1 : ℝ)]

theorem measurable_dyadicIdx (k : ℤ) : Measurable (dyadicIdx k) :=
  Measurable.comp Int.measurable_floor (measurable_id.div_const _)

theorem measurableSet_dyadicIco (k m : ℤ) : MeasurableSet (dyadicIco k m) := measurableSet_Ico

theorem volume_dyadicIco (k m : ℤ) : volume (dyadicIco k m) = ENNReal.ofReal ((2 : ℝ) ^ k) := by
  unfold dyadicIco
  rw [Real.volume_Ico]
  congr 1
  ring

/-- The dyadic average `E_k[f](x) = 2^{-k} ∫_{I_k(x)} f`. -/
def dyadicAvg (f : ℝ → ℂ) (k : ℤ) (x : ℝ) : ℂ :=
  ((2 : ℝ) ^ k)⁻¹ • ∫ y in dyadicIco k (dyadicIdx k x), f y

theorem dyadicAvg_of_mem {f : ℝ → ℂ} {k m : ℤ} {x : ℝ} (hx : x ∈ dyadicIco k m) :
    dyadicAvg f k x = ((2 : ℝ) ^ k)⁻¹ • ∫ y in dyadicIco k m, f y := by
  rw [dyadicAvg, mem_dyadicIco_iff.1 hx]

/-- The `σ`-algebra generated by the dyadic intervals of length `2^k`. -/
@[instance_reducible]
def dyadicSigma (k : ℤ) : MeasurableSpace ℝ := MeasurableSpace.comap (dyadicIdx k) inferInstance

theorem dyadicSigma_le (k : ℤ) : dyadicSigma k ≤ (inferInstance : MeasurableSpace ℝ) :=
  (measurable_dyadicIdx k).comap_le

theorem measurableSet_dyadicSigma_iff {k : ℤ} {s : Set ℝ} :
    MeasurableSet[dyadicSigma k] s ↔ ∃ T : Set ℤ, s = dyadicIdx k ⁻¹' T := by
  unfold dyadicSigma
  rw [MeasurableSpace.measurableSet_comap]
  constructor
  · rintro ⟨T, -, rfl⟩
    exact ⟨T, rfl⟩
  · rintro ⟨T, rfl⟩
    exact ⟨T, MeasurableSet.of_discrete, rfl⟩

theorem measurable_dyadicIdx_sigma (k : ℤ) : Measurable[dyadicSigma k] (dyadicIdx k) :=
  fun _ hs => ⟨_, hs, rfl⟩

/-- The `σ`-algebras get finer as the scale `2^k` decreases. -/
theorem dyadicSigma_mono {k k' : ℤ} (h : k' ≤ k) : dyadicSigma k ≤ dyadicSigma k' := by
  intro s hs
  obtain ⟨T, rfl⟩ := measurableSet_dyadicSigma_iff.1 hs
  rw [measurableSet_dyadicSigma_iff]
  set d : ℕ := (k - k').toNat with hd
  have hkd : k = k' + d := by omega
  refine ⟨{m | m / ((2 : ℤ) ^ d) ∈ T}, ?_⟩
  ext x
  simp only [Set.mem_preimage, Set.mem_ofPred_eq]
  have h2 : ((2 : ℝ) ^ k) = (2 : ℝ) ^ k' * (2 : ℝ) ^ d := by
    rw [hkd, zpow_add₀ (by norm_num), zpow_natCast]
  have h3 : x / (2 : ℝ) ^ k = (x / (2 : ℝ) ^ k') / (((2 : ℤ) ^ d : ℤ) : ℝ) := by
    rw [h2, div_div]
    push_cast
    rfl
  unfold dyadicIdx
  rw [h3, Int.floor_div_cast_of_nonneg (by positivity)]

/-- The scale at time `n` of the time-reversed, constant-padded dyadic filtration on the window
`[N - L, N]` of scales: `N, N-1, …, N-L, N-L, …`. -/
def dyadicScale (N : ℤ) (L n : ℕ) : ℤ := N - (min n L : ℕ)

theorem dyadicScale_le (N : ℤ) (L n : ℕ) : dyadicScale N L n ≤ N := by
  unfold dyadicScale
  omega

theorem dyadicScale_antitone (N : ℤ) (L : ℕ) : Antitone (dyadicScale N L) := by
  intro n n' h
  unfold dyadicScale
  omega

/-- The dyadic filtration: `n ↦ σ(dyadic intervals of length 2^{N - min n L})`. -/
def dyadicFiltration (N : ℤ) (L : ℕ) : Filtration ℕ (inferInstance : MeasurableSpace ℝ) where
  seq n := dyadicSigma (dyadicScale N L n)
  mono' := fun _ _ h => dyadicSigma_mono (dyadicScale_antitone N L h)
  le' _ := dyadicSigma_le _

section Averaging

theorem integrableOn_dyadicAvg (f : ℝ → ℂ) (k m : ℤ) :
    IntegrableOn (dyadicAvg f k) (dyadicIco k m) := by
  have hfin : volume (dyadicIco k m) ≠ ∞ := by
    rw [volume_dyadicIco]
    exact ENNReal.ofReal_ne_top
  refine (integrableOn_const hfin (C := ((2 : ℝ) ^ k)⁻¹ • ∫ y in dyadicIco k m, f y)).congr_fun
    (fun x hx => (dyadicAvg_of_mem hx).symm) (measurableSet_dyadicIco k m)

/-- On one dyadic interval the average of `f` integrates to the integral of `f`. -/
theorem setIntegral_dyadicIco_dyadicAvg (f : ℝ → ℂ) (k m : ℤ) :
    ∫ x in dyadicIco k m, dyadicAvg f k x = ∫ x in dyadicIco k m, f x := by
  have h2 : (0 : ℝ) < (2 : ℝ) ^ k := zpow_pos (by norm_num) k
  rw [setIntegral_congr_fun (measurableSet_dyadicIco k m) (fun x hx => dyadicAvg_of_mem hx),
    setIntegral_const, measureReal_def, volume_dyadicIco, ENNReal.toReal_ofReal h2.le, smul_smul,
    mul_inv_cancel₀ h2.ne', one_smul]

private theorem two_zpow_eq {N k : ℤ} (hk : k ≤ N) :
    (2 : ℝ) ^ (N : ℤ) = (2 : ℝ) ^ k * (2 : ℝ) ^ (N - k).toNat := by
  have : (N : ℤ) = k + ((N - k).toNat : ℤ) := by omega
  rw [this, zpow_add₀ (by norm_num), zpow_natCast]
  congr 1
  rw [← this]

/-- A dyadic interval `B` of length `2^N` meets the partition into dyadic intervals of length `2^k`,
`k ≤ N`, in finitely many whole atoms: `B ∩ {idx_k ∈ T} = ⋃_{m ∈ S} I_{k,m}` with `I_{k,m} ⊆ B`. -/
theorem exists_finset_dyadicIco_inter {N k m₀ : ℤ} (hk : k ≤ N) (T : Set ℤ) :
    ∃ S : Finset ℤ, dyadicIco N m₀ ∩ dyadicIdx k ⁻¹' T = (⋃ m ∈ S, dyadicIco k m) ∧
      ∀ m ∈ S, dyadicIco k m ⊆ dyadicIco N m₀ := by
  classical
  set n : ℕ := (N - k).toNat with hn
  have h2 : (0 : ℝ) < (2 : ℝ) ^ k := zpow_pos (by norm_num) k
  have hN : (2 : ℝ) ^ (N : ℤ) = (2 : ℝ) ^ k * (2 : ℝ) ^ n := two_zpow_eq hk
  set a : ℤ := m₀ * 2 ^ n with ha
  set b : ℤ := (m₀ + 1) * 2 ^ n with hb
  have haR : (a : ℝ) = m₀ * (2 : ℝ) ^ n := by simp [ha]
  have hbR : (b : ℝ) = (m₀ + 1) * (2 : ℝ) ^ n := by simp [hb]
  set S : Finset ℤ := (Finset.Ico a b).filter (· ∈ T) with hS
  have hsub : ∀ m ∈ Finset.Ico a b, dyadicIco k m ⊆ dyadicIco N m₀ := by
    intro m hm x hx
    rw [Finset.mem_Ico] at hm
    have hmR : (a : ℝ) ≤ m := by exact_mod_cast hm.1
    have hmR' : (m : ℝ) + 1 ≤ b := by exact_mod_cast hm.2
    obtain ⟨hx1, hx2⟩ := hx
    refine ⟨?_, ?_⟩
    · calc (2 : ℝ) ^ (N : ℤ) * m₀ = (2 : ℝ) ^ k * (m₀ * (2 : ℝ) ^ n) := by rw [hN]; ring
        _ = (2 : ℝ) ^ k * a := by rw [haR]
        _ ≤ (2 : ℝ) ^ k * m := mul_le_mul_of_nonneg_left hmR h2.le
        _ ≤ x := hx1
    · calc x < (2 : ℝ) ^ k * (m + 1) := hx2
        _ ≤ (2 : ℝ) ^ k * b := mul_le_mul_of_nonneg_left hmR' h2.le
        _ = (2 : ℝ) ^ (N : ℤ) * (m₀ + 1) := by rw [hbR, hN]; ring
  have hidx : ∀ x ∈ dyadicIco N m₀, dyadicIdx k x ∈ Finset.Ico a b := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := hx
    rw [Finset.mem_Ico]
    unfold dyadicIdx
    refine ⟨Int.le_floor.2 ?_, Int.floor_lt.2 ?_⟩
    · rw [le_div_iff₀ h2, haR]
      calc m₀ * (2 : ℝ) ^ n * (2 : ℝ) ^ k = (2 : ℝ) ^ (N : ℤ) * m₀ := by rw [hN]; ring
        _ ≤ x := hx1
    · rw [div_lt_iff₀ h2, hbR]
      calc x < (2 : ℝ) ^ (N : ℤ) * (m₀ + 1) := hx2
        _ = (m₀ + 1) * (2 : ℝ) ^ n * (2 : ℝ) ^ k := by rw [hN]; ring
  refine ⟨S, ?_, fun m hm => hsub m (Finset.mem_filter.1 hm).1⟩
  ext x
  simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_iUnion, hS, Finset.mem_filter,
    exists_prop]
  constructor
  · rintro ⟨hxB, hxT⟩
    exact ⟨dyadicIdx k x, ⟨hidx x hxB, hxT⟩, mem_dyadicIco_iff.2 rfl⟩
  · rintro ⟨m, ⟨hm, hmT⟩, hxm⟩
    have := mem_dyadicIco_iff.1 hxm
    exact ⟨hsub m hm hxm, by rw [this]; exact hmT⟩

theorem pairwise_disjoint_dyadicIco (k : ℤ) (S : Finset ℤ) :
    Set.Pairwise (↑S : Set ℤ) (Function.onFun Disjoint fun m => dyadicIco k m) := by
  intro m _ m' _ hmm'
  rw [Function.onFun, Set.disjoint_left]
  intro x hx hx'
  exact hmm' ((mem_dyadicIco_iff.1 hx).symm.trans (mem_dyadicIco_iff.1 hx'))

/-- The average `E_k f`, `k ≤ N`, is integrable on a dyadic interval of length `2^N`. -/
theorem integrableOn_dyadicAvg_of_le {N k m₀ : ℤ} (hk : k ≤ N) (f : ℝ → ℂ) :
    IntegrableOn (dyadicAvg f k) (dyadicIco N m₀) := by
  obtain ⟨S, hS, -⟩ := exists_finset_dyadicIco_inter (m₀ := m₀) hk Set.univ
  rw [Set.preimage_univ, Set.inter_univ] at hS
  rw [hS]
  exact (integrableOn_finset_iUnion).2 fun m _ => integrableOn_dyadicAvg f k m

/-- **The averaging formula on the atoms** (item (8) of the properties of conditional expectation,
the identification `E(f | ℱ_n) = E_{N-n} f` of the dyadic martingale below): for a scale `k ≤ N`,
a dyadic interval `B = I_{N,m₀}` of length `2^N`,
`f` integrable on `B` and any `T ⊆ ℤ`,
`∫_{B ∩ {idx_k ∈ T}} E_k f = ∫_{B ∩ {idx_k ∈ T}} f`. -/
theorem setIntegral_dyadicAvg {N k m₀ : ℤ} (hk : k ≤ N) {f : ℝ → ℂ}
    (hf : IntegrableOn f (dyadicIco N m₀)) (T : Set ℤ) :
    ∫ x in dyadicIco N m₀ ∩ dyadicIdx k ⁻¹' T, dyadicAvg f k x =
      ∫ x in dyadicIco N m₀ ∩ dyadicIdx k ⁻¹' T, f x := by
  obtain ⟨S, hset, hsub⟩ := exists_finset_dyadicIco_inter (m₀ := m₀) hk T
  have hmeas : ∀ m ∈ S, MeasurableSet (dyadicIco k m) := fun m _ => measurableSet_dyadicIco k m
  rw [hset, integral_biUnion_finset S hmeas (pairwise_disjoint_dyadicIco k S)
      fun m _ => integrableOn_dyadicAvg f k m,
    integral_biUnion_finset S hmeas (pairwise_disjoint_dyadicIco k S)
      fun m hm => hf.mono_set (hsub m hm)]
  exact Finset.sum_congr rfl fun m _ => setIntegral_dyadicIco_dyadicAvg f k m

end Averaging

section DyadicMartingale

/-- The normalized Lebesgue measure `2^{-N} dx` on the dyadic interval `I_{N,m₀}` of length `2^N`:
a probability measure on `ℝ` (the probability space of the dyadic martingale below). -/
def dyadicMeasure (N m₀ : ℤ) : Measure ℝ :=
  ENNReal.ofReal ((2 : ℝ) ^ (-(N : ℤ))) • volume.restrict (dyadicIco N m₀)

instance (N m₀ : ℤ) : IsProbabilityMeasure (dyadicMeasure N m₀) := by
  refine ⟨?_⟩
  rw [dyadicMeasure, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
    volume_dyadicIco, smul_eq_mul, ← ENNReal.ofReal_mul (by positivity), ← zpow_add₀ (by norm_num)]
  simp

theorem dyadicMeasure_lintegral {N m₀ : ℤ} (h : ℝ → ℝ≥0∞) :
    ∫⁻ x, h x ∂dyadicMeasure N m₀ =
      ENNReal.ofReal ((2 : ℝ) ^ (-(N : ℤ))) * ∫⁻ x in dyadicIco N m₀, h x := by
  rw [dyadicMeasure, lintegral_smul_measure (R := ℝ≥0∞)]
  rfl

theorem setIntegral_dyadicMeasure {N m₀ : ℤ} {s : Set ℝ} (hs : MeasurableSet s)
    (h : ℝ → ℂ) :
    ∫ x in s, h x ∂dyadicMeasure N m₀ =
      (2 : ℝ) ^ (-(N : ℤ)) • ∫ x in dyadicIco N m₀ ∩ s, h x := by
  rw [dyadicMeasure, Measure.restrict_smul, integral_smul_measure,
    Measure.restrict_restrict hs, Set.inter_comm, ENNReal.toReal_ofReal (by positivity)]

theorem absolutelyContinuous_dyadicMeasure (N m₀ : ℤ) : dyadicMeasure N m₀ ≪ volume := by
  exact Measure.smul_absolutelyContinuous.trans Measure.restrict_le_self.absolutelyContinuous

theorem integrable_dyadicMeasure_of_integrableOn {N m₀ : ℤ} {h : ℝ → ℂ}
    (hh : IntegrableOn h (dyadicIco N m₀)) : Integrable h (dyadicMeasure N m₀) :=
  Integrable.smul_measure hh ENNReal.ofReal_ne_top

/-- The averaging formula for the probability measure: for `k ≤ N` and
`s ∈ σ(dyadic intervals of length 2^k)`,
`∫_s E_k f dμ = ∫_s f dμ`. -/
theorem setIntegral_dyadicAvg_measure {N k m₀ : ℤ} (hk : k ≤ N) {f : ℝ → ℂ}
    (hf : IntegrableOn f (dyadicIco N m₀)) {s : Set ℝ} (hs : MeasurableSet[dyadicSigma k] s) :
    ∫ x in s, dyadicAvg f k x ∂dyadicMeasure N m₀ = ∫ x in s, f x ∂dyadicMeasure N m₀ := by
  obtain ⟨T, rfl⟩ := measurableSet_dyadicSigma_iff.1 hs
  have hsm : MeasurableSet (dyadicIdx k ⁻¹' T) :=
    (measurable_dyadicIdx k) (MeasurableSet.of_discrete)
  rw [setIntegral_dyadicMeasure hsm, setIntegral_dyadicMeasure hsm,
    setIntegral_dyadicAvg hk hf T]

theorem measurable_dyadicAvg_sigma (f : ℝ → ℂ) (k : ℤ) :
    Measurable[dyadicSigma k] (dyadicAvg f k) :=
  (Measurable.of_discrete (f := fun m : ℤ => ((2 : ℝ) ^ k)⁻¹ • ∫ y in dyadicIco k m, f y)).comp
    (measurable_dyadicIdx_sigma k)

/-- **The dyadic martingale** (Zorin-Kranich's notes, 00-background.tex L84-L90): for `f`
integrable on a dyadic interval `B = I_{N,m₀}`, the time-reversed dyadic averages
`n ↦ E_{N - min n L} f` form a martingale for the dyadic filtration on the probability space
`(ℝ, 2^{-N} dx|_B)`. -/
theorem martingale_dyadicAvg {N : ℤ} {L : ℕ} {m₀ : ℤ} {f : ℝ → ℂ}
    (hf : IntegrableOn f (dyadicIco N m₀)) :
    Martingale (fun n => dyadicAvg f (dyadicScale N L n)) (dyadicFiltration N L)
      (dyadicMeasure N m₀) := by
  refine martingale_of_setIntegral_eq_succ (fun n => ?_) (fun n => ?_) (fun n s hs => ?_)
  · exact (measurable_dyadicAvg_sigma f (dyadicScale N L n)).stronglyMeasurable
  · exact integrable_dyadicMeasure_of_integrableOn
      (integrableOn_dyadicAvg_of_le (dyadicScale_le N L n) f)
  · have hs' : MeasurableSet[dyadicSigma (dyadicScale N L (n + 1))] s :=
      (dyadicFiltration N L).mono (Nat.le_succ n) s hs
    rw [setIntegral_dyadicAvg_measure (dyadicScale_le N L n) hf hs,
      setIntegral_dyadicAvg_measure (dyadicScale_le N L (n + 1)) hf hs']

end DyadicMartingale

section Window

/-- The norm of a martingale is a (nonnegative) submartingale. -/
theorem submartingale_norm {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}
    {ℱ : Filtration ℕ m0} {𝕜 : Type*} [RCLike 𝕜] {g : ℕ → Ω → 𝕜} (hg : Martingale g ℱ μ) :
    Submartingale (fun n ω => ‖g n ω‖) ℱ μ := by
  refine ⟨fun n => (hg.stronglyMeasurable n).norm, fun i j hij => ?_,
    fun n => (hg.integrable n).norm⟩
  have h1 := norm_condExp_le (μ := μ) (m := ℱ i) (g j)
  filter_upwards [h1, hg.condExp_ae_eq hij] with ω h1 h2
  rw [h2] at h1
  exact h1

/-- **`L^p` contractivity of the dyadic martingale**: `‖E_k f‖_{L^p(μ)} ≤ ‖f‖_{L^p(μ)}`. -/
theorem lintegral_enorm_dyadicAvg_le {N : ℤ} {L : ℕ} {m₀ : ℤ} {f : ℝ → ℂ}
    (hf : IntegrableOn f (dyadicIco N m₀)) (hfm : AEStronglyMeasurable f (dyadicMeasure N m₀))
    {p : ℝ} (hp : 1 ≤ p) (n : ℕ) :
    ∫⁻ x, ‖dyadicAvg f (dyadicScale N L n) x‖ₑ ^ p ∂dyadicMeasure N m₀ ≤
      ∫⁻ x, ‖f x‖ₑ ^ p ∂dyadicMeasure N m₀ := by
  have hp0 : 0 < p := by linarith
  set μ := dyadicMeasure N m₀ with hμ
  have hint : Integrable f μ := integrable_dyadicMeasure_of_integrableOn hf
  have hgint : Integrable (dyadicAvg f (dyadicScale N L n)) μ :=
    integrable_dyadicMeasure_of_integrableOn (integrableOn_dyadicAvg_of_le (dyadicScale_le N L n) f)
  have hgm : AEStronglyMeasurable[dyadicSigma (dyadicScale N L n)]
      (dyadicAvg f (dyadicScale N L n)) μ :=
    (measurable_dyadicAvg_sigma f (dyadicScale N L n)).stronglyMeasurable.aestronglyMeasurable
  have hae : dyadicAvg f (dyadicScale N L n) =ᵐ[μ] μ[f | dyadicSigma (dyadicScale N L n)] :=
    ae_eq_condExp_of_forall_setIntegral_eq (dyadicSigma_le _) hint
      (fun s _ _ => hgint.integrableOn)
      (fun s hs _ => setIntegral_dyadicAvg_measure (dyadicScale_le N L n) hf hs) hgm
  have hgam : AEStronglyMeasurable (dyadicAvg f (dyadicScale N L n)) μ :=
    hgm.mono (dyadicSigma_le _)
  rw [lintegral_enorm_rpow_eq hgam hp0, lintegral_enorm_rpow_eq hfm hp0]
  refine ENNReal.rpow_le_rpow ?_ hp0.le
  calc eLpNorm (dyadicAvg f (dyadicScale N L n)) (ENNReal.ofReal p) μ
      = eLpNorm (μ[f | dyadicSigma (dyadicScale N L n)]) (ENNReal.ofReal p) μ :=
        eLpNorm_congr_ae hae
    _ ≤ eLpNorm f (ENNReal.ofReal p) μ :=
        eLpNorm_condExp_le_eLpNorm f (by simpa using hp)

/-- **Lépingle + Doob for the dyadic martingale on the probability space `(ℝ, 2^{-N} dx|_B)`**
(Lépingle for `g`, then Doob for the submartingale `|g|`): for
`1 < p < ∞`, `r > 2`,
`‖V^r g‖_p ≤ 672 p r/(r-2) · p' ‖f‖_p`. -/
theorem dyadic_seqVariation_le {N : ℤ} {L : ℕ} {m₀ : ℤ} {f : ℝ → ℂ} {p r : ℝ} (hp : 1 < p)
    (hr : 2 < r)
    (hf : IntegrableOn f (dyadicIco N m₀)) (hfm : AEStronglyMeasurable f (dyadicMeasure N m₀))
    (hfin : ∫⁻ x, ‖f x‖ₑ ^ p ∂dyadicMeasure N m₀ ≠ ∞) :
    (∫⁻ x, seqVariationOn r (fun n => dyadicAvg f (dyadicScale N L n) x) L ^ p
        ∂dyadicMeasure N m₀) ^ (1 / p) ≤
      ENNReal.ofReal (672 * p * (r / (r - 2))) *
        (ENNReal.ofReal (p / (p - 1)) * (∫⁻ x, ‖f x‖ₑ ^ p ∂dyadicMeasure N m₀) ^ (1 / p)) := by
  have hp1 : 1 ≤ p := hp.le
  set μ := dyadicMeasure N m₀ with hμ
  set g : ℕ → ℝ → ℂ := fun n => dyadicAvg f (dyadicScale N L n) with hg_def
  have hg : Martingale g (dyadicFiltration N L) μ := martingale_dyadicAvg hf
  have h1 := lepingle_horizon hg hp1 hr L
  have hsub : Submartingale (fun n ω => ‖g n ω‖) (dyadicFiltration N L) μ := submartingale_norm hg
  have hnn : ∀ n ω, 0 ≤ ‖g n ω‖ := fun _ _ => norm_nonneg _
  have hgle : ∀ n, ∫⁻ x, ‖g n x‖ₑ ^ p ∂μ ≤ ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := fun n =>
    lintegral_enorm_dyadicAvg_le hf hfm hp1 n
  have hfin_n : ∫⁻ ω, ‖‖g L ω‖‖ₑ ^ p ∂μ ≠ ∞ := by
    simp only [enorm_norm]
    exact ne_top_of_le_ne_top hfin (hgle _)
  have h2 := doob_lp_aux hsub hnn hp L hfin_n
  have hmax : ∀ ω, maxUpTo (fun n ω => ‖g n ω‖) L ω = maxUpTo g L ω := by
    intro ω
    simp [maxUpTo, enorm_norm]
  simp only [hmax, enorm_norm] at h2
  calc (∫⁻ x, seqVariationOn r (fun n => g n x) L ^ p ∂μ) ^ (1 / p)
      ≤ ENNReal.ofReal (672 * p * (r / (r - 2))) * (∫⁻ ω, maxUpTo g L ω ^ p ∂μ) ^ (1 / p) :=
        h1
    _ ≤ ENNReal.ofReal (672 * p * (r / (r - 2))) *
          (ENNReal.ofReal (p / (p - 1)) * (∫⁻ ω, ‖g L ω‖ₑ ^ p ∂μ) ^ (1 / p)) := by
        gcongr
    _ ≤ ENNReal.ofReal (672 * p * (r / (r - 2))) *
          (ENNReal.ofReal (p / (p - 1)) * (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) ^ (1 / p)) := by
        exact mul_le_mul_right (mul_le_mul_right
          (ENNReal.rpow_le_rpow (hgle L) (by positivity)) _) _

end Window

section Chains

open PrimeCarleson PrimeCarleson.Proof.MswTransference

/-- **The variation over a scale window is dominated by the variation of the reversed padded
martingale**: for the window `W = [N - L, N]` of scales,
`V^r_{k ∈ W}(E_k f(x)) ≤ V^r(n ↦ E_{N - min n L} f(x); 0..L)` (an increasing chain of scales
is a decreasing chain of times; reversal of the order does not change the sum). -/
theorem rVariationOn_dyadicWindow_le (r : ℝ) (f : ℝ → ℂ) (N : ℤ) (L : ℕ) (x : ℝ) :
    rVariationOn r (((↑) : ℤ → ℝ) '' Set.Icc (N - L) N) (fun t => dyadicAvg f ⌊t⌋ x) ≤
      seqVariationOn r (fun n => dyadicAvg f (dyadicScale N L n) x) L := by
  refine rVariationOn_le fun J t ht hS => ?_
  choose k hk hkt using hS
  have hkm : StrictMono k := fun i j hij => by
    have := ht hij
    rw [← hkt i, ← hkt j] at this
    exact_mod_cast this
  set u : Fin (J + 1) → ℕ := fun i => ((N : ℤ) - k (Fin.rev i)).toNat with hu
  have hkle : ∀ i, k i ≤ N := fun i => (hk i).2
  have hkge : ∀ i, N - L ≤ k i := fun i => (hk i).1
  have hum : StrictMono u := by
    intro i j hij
    have h1 : Fin.rev j < Fin.rev i := Fin.rev_lt_rev.2 hij
    have h2 := hkm h1
    have h3 := hkle (Fin.rev i)
    have h4 := hkle (Fin.rev j)
    simp only [hu]
    omega
  have hub : ∀ i, u i ≤ L := fun i => by
    have h3 := hkle (Fin.rev i)
    have h4 := hkge (Fin.rev i)
    simp only [hu]
    omega
  have hscale : ∀ i, dyadicScale N L (u i) = k (Fin.rev i) := fun i => by
    have h3 := hkle (Fin.rev i)
    have h4 := hkge (Fin.rev i)
    unfold dyadicScale
    simp only [hu]
    omega
  have hterm : ∀ i : Fin J, edist (dyadicAvg f (dyadicScale N L (u i.castSucc)) x)
      (dyadicAvg f (dyadicScale N L (u i.succ)) x) ^ r =
      ‖dyadicAvg f ⌊t (Fin.rev i).castSucc⌋ x - dyadicAvg f ⌊t (Fin.rev i).succ⌋ x‖ₑ ^ r := by
    intro i
    rw [hscale, hscale, Fin.rev_castSucc, Fin.rev_succ, edist_comm, edist_eq_enorm_sub,
      ← hkt, ← hkt, Int.floor_intCast, Int.floor_intCast]
  have hsum : ∑ i : Fin J, ‖dyadicAvg f ⌊t i.castSucc⌋ x - dyadicAvg f ⌊t i.succ⌋ x‖ₑ ^ r =
      ∑ i : Fin J, edist (dyadicAvg f (dyadicScale N L (u i.castSucc)) x)
        (dyadicAvg f (dyadicScale N L (u i.succ)) x) ^ r := by
    simp_rw [hterm]
    exact (Equiv.sum_comp Fin.revPerm
      (fun i : Fin J => ‖dyadicAvg f ⌊t i.castSucc⌋ x - dyadicAvg f ⌊t i.succ⌋ x‖ₑ ^ r)).symm
  rw [hsum]
  exact le_seqVariationOn (f := fun n => dyadicAvg f (dyadicScale N L n) x) hum hub

end Chains

section FiniteWindow

open PrimeCarleson PrimeCarleson.Proof.MswTransference

theorem integrableOn_dyadicIco_of_memLp {f : ℝ → ℂ} {p : ℝ} (hp : 1 ≤ p)
    (hf : MemLp f (ENNReal.ofReal p) volume) (N m₀ : ℤ) :
    IntegrableOn f (dyadicIco N m₀) := by
  have : IsFiniteMeasure (volume.restrict (dyadicIco N m₀)) :=
    ⟨by rw [Measure.restrict_apply_univ, volume_dyadicIco]; exact ENNReal.ofReal_lt_top⟩
  exact (hf.restrict (dyadicIco N m₀)).integrable (by simpa using hp)

theorem lintegral_enorm_rpow_lt_top {f : ℝ → ℂ} {p : ℝ} (hp : 0 < p)
    (hf : MemLp f (ENNReal.ofReal p) volume) : ∫⁻ x, ‖f x‖ₑ ^ p < ∞ := by
  rw [lintegral_enorm_rpow_eq hf.aestronglyMeasurable hp]
  exact ENNReal.rpow_lt_top_of_nonneg hp.le hf.eLpNorm_lt_top.ne

/-- **Dyadic Lépingle on a finite scale window**: for `1 < p < ∞`,
`r > 2`, integers `K ≥ 0` and `N` with `K + N ≥ 0`, a dyadic interval `B = I_{N,m₀}` and
`f ∈ L^p(ℝ)`,
`‖V^r_{k ∈ [-K,N]}(E_k f(x))‖_{L^p(B, dx)} ≤ 672 p p' (r/(r-2)) ‖f‖_{L^p(B)}`,
`p' = p/(p-1)`.  The constant does not depend on `K`, `N`, `m₀`. -/
theorem dyadic_finite_window {N : ℤ} {K : ℕ} (hNK : 0 ≤ N + K) {m₀ : ℤ} {f : ℝ → ℂ} {p r : ℝ}
    (hp : 1 < p) (hr : 2 < r) (hf : MemLp f (ENNReal.ofReal p) volume) :
    (∫⁻ x in dyadicIco N m₀, rVariationOn r (((↑) : ℤ → ℝ) '' Set.Icc (-(K : ℤ)) N)
        (fun t => dyadicAvg f ⌊t⌋ x) ^ p) ^ (1 / p) ≤
      ENNReal.ofReal (672 * p * (p / (p - 1)) * (r / (r - 2))) *
        (∫⁻ x in dyadicIco N m₀, ‖f x‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := by linarith
  have hfB : IntegrableOn f (dyadicIco N m₀) :=
    integrableOn_dyadicIco_of_memLp hp.le hf N m₀
  have hfm : AEStronglyMeasurable f (dyadicMeasure N m₀) :=
    hf.aestronglyMeasurable.mono_ac (absolutelyContinuous_dyadicMeasure N m₀)
  set c : ℝ≥0∞ := ENNReal.ofReal ((2 : ℝ) ^ (-(N : ℤ))) with hc
  have hc0 : c ≠ 0 := by
    rw [hc, Ne, ENNReal.ofReal_eq_zero, not_le]
    positivity
  have hct : c ≠ ∞ := ENNReal.ofReal_ne_top
  set Y := ∫⁻ x in dyadicIco N m₀, ‖f x‖ₑ ^ p with hY
  have hYtop : Y ≠ ∞ := by
    refine ne_top_of_le_ne_top (lintegral_enorm_rpow_lt_top hp0 hf).ne ?_
    exact setLIntegral_le_lintegral _ _
  have hfin : ∫⁻ x, ‖f x‖ₑ ^ p ∂dyadicMeasure N m₀ ≠ ∞ := by
    rw [dyadicMeasure_lintegral]
    exact ENNReal.mul_ne_top hct hYtop
  have hmain := dyadic_seqVariation_le (N := N) (L := (N + K).toNat) hp hr hfB hfm hfin
  set X := ∫⁻ x in dyadicIco N m₀, rVariationOn r (((↑) : ℤ → ℝ) '' Set.Icc (-(K : ℤ)) N)
        (fun t => dyadicAvg f ⌊t⌋ x) ^ p with hX
  have hXle : c * X ≤ ∫⁻ x, seqVariationOn r
      (fun n => dyadicAvg f (dyadicScale N (N + K).toNat n) x) (N + K).toNat ^ p
      ∂dyadicMeasure N m₀ := by
    rw [dyadicMeasure_lintegral]
    refine mul_le_mul_right (lintegral_mono fun x => ?_) _
    have hwin : N - ((N + K).toNat : ℕ) = -(K : ℤ) := by omega
    have := rVariationOn_dyadicWindow_le r f N (N + K).toNat x
    rw [hwin] at this
    exact ENNReal.rpow_le_rpow this hp0.le
  have h1 : (c * X) ^ (1 / p) ≤ ENNReal.ofReal (672 * p * (r / (r - 2))) *
      (ENNReal.ofReal (p / (p - 1)) * (c * Y) ^ (1 / p)) := by
    refine le_trans (ENNReal.rpow_le_rpow hXle (by positivity)) ?_
    have hY' : ∫⁻ x, ‖f x‖ₑ ^ p ∂dyadicMeasure N m₀ = c * Y := dyadicMeasure_lintegral _
    rw [hY'] at hmain
    exact hmain
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity)] at h1
  have hc1 : c ^ (1 / p) ≠ 0 := by
    rw [Ne, ENNReal.rpow_eq_zero_iff]
    rintro (⟨h, _⟩ | ⟨_, h⟩)
    · exact hc0 h
    · have : 0 < 1 / p := by positivity
      linarith
  have hc2 : c ^ (1 / p) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hct
  have h2 : c ^ (1 / p) * X ^ (1 / p) ≤ c ^ (1 / p) *
      (ENNReal.ofReal (672 * p * (r / (r - 2))) *
        (ENNReal.ofReal (p / (p - 1)) * Y ^ (1 / p))) := by
    refine h1.trans (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
    ring
  have h3 := (ENNReal.mul_le_mul_iff_right hc1 hc2).1 h2
  refine h3.trans (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  congr 2
  ring

end FiniteWindow

section Exhaustion

open PrimeCarleson PrimeCarleson.Proof.MswTransference PrimeCarleson.Proof.Common

/-- The `r`-variation of the step function `t ↦ b ⌊t⌋` over the integer points `W ⊆ ℤ` is the
supremum over strictly increasing chains of integers in `W` ([O+] `definitionofvariation` over
`ℤ`). -/
theorem rVariationOn_intCast_image_eq (r : ℝ) (W : Set ℤ) (b : ℤ → ℂ) :
    rVariationOn r (((↑) : ℤ → ℝ) '' W) (fun t => b ⌊t⌋) =
      ⨆ (J : ℕ) (k : Fin (J + 1) → ℤ) (_ : StrictMono k) (_ : ∀ i, k i ∈ W),
        (∑ i : Fin J, ‖b (k i.castSucc) - b (k i.succ)‖ₑ ^ r) ^ (1 / r) := by
  refine le_antisymm (rVariationOn_le fun J t ht hS => ?_)
    (iSup_le fun J => iSup_le fun k => iSup_le fun hk => iSup_le fun hW => ?_)
  · choose k hk hkt using hS
    have hkm : StrictMono k := fun i j hij => by
      have := ht hij
      rw [← hkt i, ← hkt j] at this
      exact_mod_cast this
    refine le_iSup_of_le J (le_iSup_of_le k (le_iSup_of_le hkm (le_iSup_of_le hk ?_)))
    refine le_of_eq (congrArg (· ^ (1 / r)) (Finset.sum_congr rfl fun i _ => ?_))
    rw [← hkt, ← hkt, Int.floor_intCast, Int.floor_intCast]
  · have := le_rVariationOn (r := r) (S := ((↑) : ℤ → ℝ) '' W) (a := fun t => b ⌊t⌋) (J := J)
      (t := fun i => (k i : ℝ)) (Int.cast_strictMono.comp hk) fun i => ⟨k i, hW i, rfl⟩
    simpa [Int.floor_intCast] using this

theorem measurable_dyadicAvg (f : ℝ → ℂ) (k : ℤ) : Measurable (dyadicAvg f k) :=
  (measurable_dyadicAvg_sigma f k).mono (dyadicSigma_le k) le_rfl

/-- `x ↦ V^r_{k ∈ W}(E_k f(x))` is measurable (a supremum over countably many integer chains). -/
theorem measurable_rVariationOn_dyadic (r : ℝ) (f : ℝ → ℂ) (W : Set ℤ) :
    Measurable fun x => rVariationOn r (((↑) : ℤ → ℝ) '' W) (fun t => dyadicAvg f ⌊t⌋ x) := by
  have : (fun x => rVariationOn r (((↑) : ℤ → ℝ) '' W) (fun t => dyadicAvg f ⌊t⌋ x)) =
      fun x => ⨆ (J : ℕ) (k : Fin (J + 1) → ℤ) (_ : StrictMono k) (_ : ∀ i, k i ∈ W),
        (∑ i : Fin J, ‖dyadicAvg f (k i.castSucc) x - dyadicAvg f (k i.succ) x‖ₑ ^ r) ^ (1 / r) :=
    funext fun x => rVariationOn_intCast_image_eq r W (fun m => dyadicAvg f m x)
  rw [this]
  refine Measurable.iSup fun J => Measurable.iSup fun k => Measurable.iSup fun _ =>
    Measurable.iSup fun _ => ?_
  refine Measurable.pow_const (Finset.measurable_sum _ fun i _ => ?_) _
  exact (((measurable_dyadicAvg f _).sub (measurable_dyadicAvg f _)).enorm).pow_const _

/-- The variation over all of `ℤ` is the increasing limit of the variations over the windows
`[-n, n]` (a finite chain lies in some window). -/
theorem rVariationOn_range_intCast_eq_iSup (r : ℝ) (b : ℤ → ℂ) :
    rVariationOn r (Set.range ((↑) : ℤ → ℝ)) (fun t => b ⌊t⌋) =
      ⨆ n : ℕ, rVariationOn r (((↑) : ℤ → ℝ) '' Set.Icc (-(n : ℤ)) n) (fun t => b ⌊t⌋) := by
  refine le_antisymm (rVariationOn_le fun J t ht hS => ?_)
    (iSup_le fun n => rVariationOn_mono_set (Set.image_subset_range _ _) _)
  choose k hkt using hS
  obtain ⟨M, hM⟩ : ∃ M : ℕ, ∀ i, (k i).natAbs ≤ M :=
    ⟨∑ i, (k i).natAbs, fun i => Finset.single_le_sum (f := fun i => (k i).natAbs)
      (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)⟩
  have hkM : ∀ i, k i ∈ Set.Icc (-(M : ℤ)) M := fun i => by
    have := hM i
    rw [Set.mem_Icc]
    omega
  have h1 := le_rVariationOn (r := r) (a := fun t => b ⌊t⌋)
    (S := ((↑) : ℤ → ℝ) '' Set.Icc (-(M : ℤ)) M) ht fun i => ⟨k i, hkM i, hkt i⟩
  exact h1.trans (le_iSup (fun n : ℕ => rVariationOn r (((↑) : ℤ → ℝ) '' Set.Icc (-(n : ℤ)) n)
    (fun t => b ⌊t⌋)) M)

end Exhaustion

section Final

open PrimeCarleson PrimeCarleson.Proof.MswTransference PrimeCarleson.Proof.Common

theorem le_rpow_of_root_le {a b K : ℝ≥0∞} {p : ℝ} (hp : 0 < p)
    (h : a ^ (1 / p) ≤ K * b ^ (1 / p)) : a ≤ K ^ p * b := by
  have h1 := ENNReal.rpow_le_rpow h hp.le
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ hp.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp.ne',
    ENNReal.rpow_one] at h1
  exact h1

/-- **The dyadic Lépingle inequality on a half-line** (the exhaustion step): `H` is exhausted by
the increasing dyadic intervals `I_{n,m₀}`,
`n ∈ ℕ`.  The scale windows `[-n, n]` increase to `ℤ` and the intervals to `H`, so monotone
convergence gives `‖V^r_{k ∈ ℤ}(E_k f)‖_{L^p(H)} ≤ 672 p p' (r/(r-2)) ‖f‖_{L^p(H)}`. -/
theorem dyadic_halfLine {m₀ : ℤ} {H : Set ℝ}
    (hsub : ∀ n : ℕ, dyadicIco n m₀ ⊆ H)
    (hmono : ∀ n : ℕ, dyadicIco n m₀ ⊆ dyadicIco (n + 1 : ℕ) m₀)
    (hcover : ∀ x ∈ H, ∃ n : ℕ, x ∈ dyadicIco n m₀)
    {f : ℝ → ℂ} {p r : ℝ} (hp : 1 < p) (hr : 2 < r) (hf : MemLp f (ENNReal.ofReal p) volume) :
    (∫⁻ x in H, rVariationOn r (Set.range ((↑) : ℤ → ℝ)) (fun t => dyadicAvg f ⌊t⌋ x) ^ p) ^
        (1 / p) ≤
      ENNReal.ofReal (672 * p * (p / (p - 1)) * (r / (r - 2))) *
        (∫⁻ x in H, ‖f x‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := by linarith
  set K : ℝ≥0∞ := ENNReal.ofReal (672 * p * (p / (p - 1)) * (r / (r - 2))) with hK
  set V : ℝ → ℝ≥0∞ := fun x =>
    rVariationOn r (Set.range ((↑) : ℤ → ℝ)) (fun t => dyadicAvg f ⌊t⌋ x) with hV
  set Vn : ℕ → ℝ → ℝ≥0∞ := fun n x =>
    rVariationOn r (((↑) : ℤ → ℝ) '' Set.Icc (-(n : ℤ)) n) (fun t => dyadicAvg f ⌊t⌋ x) with hVn
  have hVnm : ∀ n, Measurable (Vn n) := fun n => measurable_rVariationOn_dyadic r f _
  have hVsup : ∀ x, V x = ⨆ n, Vn n x := fun x =>
    rVariationOn_range_intCast_eq_iSup r (fun m => dyadicAvg f m x)
  have hVn_le : ∀ n x, Vn n x ≤ V x := fun n x =>
    rVariationOn_mono_set (Set.image_subset_range _ _) _
  have hVn_mono : ∀ x, Monotone fun n => Vn n x := fun x =>
    monotone_nat_of_le_succ fun n => rVariationOn_mono_set
      (Set.image_mono (Set.Icc_subset_Icc (by omega) (by omega))) _
  have hB_mono : Monotone fun n : ℕ => dyadicIco n m₀ := monotone_nat_of_le_succ hmono
  set g : ℕ → ℝ → ℝ≥0∞ := fun n => (dyadicIco n m₀).indicator (Vn n) with hg
  have hgm : ∀ n, Measurable (g n) := fun n =>
    (hVnm n).indicator (measurableSet_dyadicIco _ _)
  have hg_mono : ∀ x, Monotone fun n => g n x := fun x =>
    monotone_nat_of_le_succ fun n => by
      by_cases hx : x ∈ dyadicIco n m₀
      · simp only [hg, Set.indicator_of_mem hx, Set.indicator_of_mem (hmono n hx)]
        exact hVn_mono x (Nat.le_succ n)
      · simp only [hg, Set.indicator_of_notMem hx]
        exact zero_le
  have hsup : ∀ x, (⨆ n, g n x) = H.indicator V x := by
    intro x
    by_cases hx : x ∈ H
    · rw [Set.indicator_of_mem hx]
      obtain ⟨n0, hn0⟩ := hcover x hx
      refine le_antisymm (iSup_le fun n => ?_) ?_
      · exact Set.indicator_apply_le' (fun _ => hVn_le n x) (fun _ => zero_le)
      · rw [hVsup x]
        refine iSup_le fun m => ?_
        calc Vn m x ≤ Vn (max m n0) x := hVn_mono x (le_max_left _ _)
          _ = g (max m n0) x := by
              simp only [hg, Set.indicator_of_mem (hB_mono (le_max_right m n0) hn0)]
          _ ≤ ⨆ n, g n x := le_iSup (fun n => g n x) _
    · rw [Set.indicator_of_notMem hx]
      refine le_antisymm (iSup_le fun n => ?_) zero_le
      have : x ∉ dyadicIco n m₀ := fun h => hx (hsub n h)
      simp only [hg, Set.indicator_of_notMem this]
      exact le_rfl
  have hgn : ∀ n, (∫⁻ x, g n x ^ p) ^ (1 / p) ≤ K * (∫⁻ x in H, ‖f x‖ₑ ^ p) ^ (1 / p) := by
    intro n
    have h1 : ∫⁻ x, g n x ^ p = ∫⁻ x in dyadicIco n m₀, Vn n x ^ p := by
      rw [← lintegral_indicator (measurableSet_dyadicIco _ _)]
      refine lintegral_congr fun x => ?_
      by_cases hx : x ∈ dyadicIco n m₀
      · simp only [hg, Set.indicator_of_mem hx]
      · simp only [hg, Set.indicator_of_notMem hx, ENNReal.zero_rpow_of_pos hp0]
    rw [h1]
    refine (dyadic_finite_window (N := (n : ℤ)) (K := n) (by positivity) (m₀ := m₀) hp hr
      hf).trans ?_
    exact mul_le_mul_right (ENNReal.rpow_le_rpow
      (lintegral_mono_set (hsub n)) (by positivity)) _
  have hmain := lintegral_root_iSup_le (μ := volume) hgm (fun x => hg_mono x) hp0 hgn
  have h2 : ∫⁻ x, (⨆ n, g n x) ^ p = ∫⁻ x in H, V x ^ p := by
    simp_rw [hsup]
    have hHm : MeasurableSet H := by
      have : H = ⋃ n : ℕ, dyadicIco (n : ℤ) m₀ := by
        ext x
        simp only [Set.mem_iUnion]
        exact ⟨hcover x, fun ⟨n, hn⟩ => hsub n hn⟩
      rw [this]
      exact MeasurableSet.iUnion fun n => measurableSet_dyadicIco _ _
    rw [← lintegral_indicator hHm]
    refine lintegral_congr fun x => ?_
    by_cases hx : x ∈ H
    · simp only [Set.indicator_of_mem hx]
    · simp only [Set.indicator_of_notMem hx, ENNReal.zero_rpow_of_pos hp0]
  rw [h2] at hmain
  exact hmain

theorem dyadicIco_zero (n : ℕ) : dyadicIco n 0 = Set.Ico 0 ((2 : ℝ) ^ n) := by
  simp [dyadicIco]

theorem dyadicIco_neg_one (n : ℕ) : dyadicIco n (-1) = Set.Ico (-((2 : ℝ) ^ n)) 0 := by
  simp [dyadicIco]

/-- **Lépingle's inequality for the dyadic martingale of averages on `ℝ`**
(inequality `vedma` of [O+], L1990-L2000, with the explicit constant): for `1 < p < ∞`,
`r > 2` and `f ∈ L^p(ℝ)`,
`‖V^r_{k ∈ ℤ}(E_k[f](x))‖_{L^p_x(ℝ)} ≤ 672 p p' (r/(r-2)) ‖f‖_{L^p(ℝ)}`, `p' = p/(p-1)`,
where `E_k[f](x) = 2^{-k} ∫_{I_k(x)} f` (`dyadicAvg`) with `I_k(x)` the dyadic interval
`[2^k m, 2^k (m+1))` of length `2^k` containing `x`, and `V^r_{k ∈ ℤ}` is
`rVariationOn r (range ((↑) : ℤ → ℝ))` of the step function `t ↦ E_{⌊t⌋}[f](x)`
(the supremum over finite increasing chains of `ℤ`). All quantities are `ℝ≥0∞`-valued. -/
theorem lepingle_dyadic {f : ℝ → ℂ} {p r : ℝ} (hp : 1 < p) (hr : 2 < r)
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    (∫⁻ x, rVariationOn r (Set.range ((↑) : ℤ → ℝ)) (fun t => dyadicAvg f ⌊t⌋ x) ^ p) ^ (1 / p) ≤
      ENNReal.ofReal (672 * p * (p / (p - 1)) * (r / (r - 2))) *
        (∫⁻ x, ‖f x‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := by linarith
  set K : ℝ≥0∞ := ENNReal.ofReal (672 * p * (p / (p - 1)) * (r / (r - 2))) with hK
  set V : ℝ → ℝ≥0∞ := fun x =>
    rVariationOn r (Set.range ((↑) : ℤ → ℝ)) (fun t => dyadicAvg f ⌊t⌋ x) with hV
  have hpos : ∀ n : ℕ, (0 : ℝ) < (2 : ℝ) ^ n := fun n => by positivity
  have hA := dyadic_halfLine (m₀ := 0) (H := Set.Ici 0)
    (fun n x hx => by
      rw [dyadicIco_zero] at hx
      exact hx.1)
    (fun n x hx => by
      rw [dyadicIco_zero] at hx ⊢
      refine ⟨hx.1, hx.2.trans_le ?_⟩
      rw [pow_succ]
      nlinarith [hpos n])
    (fun x hx => by
      obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt x (one_lt_two : (1 : ℝ) < 2)
      exact ⟨n, by rw [dyadicIco_zero]; exact ⟨hx, hn⟩⟩) hp hr hf
  have hB := dyadic_halfLine (m₀ := -1) (H := (Set.Ici (0 : ℝ))ᶜ)
    (fun n x hx => by
      rw [dyadicIco_neg_one] at hx
      exact not_le.2 hx.2)
    (fun n x hx => by
      rw [dyadicIco_neg_one] at hx ⊢
      refine ⟨le_trans ?_ hx.1, hx.2⟩
      rw [pow_succ]
      nlinarith [hpos n])
    (fun x hx => by
      have hx' : x < 0 := not_le.1 hx
      obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (-x) (one_lt_two : (1 : ℝ) < 2)
      exact ⟨n, by rw [dyadicIco_neg_one]; exact ⟨by linarith, hx'⟩⟩) hp hr hf
  have hA' := le_rpow_of_root_le hp0 hA
  have hB' := le_rpow_of_root_le hp0 hB
  have hsplit : ∀ h : ℝ → ℝ≥0∞, ∫⁻ x, h x =
      (∫⁻ x in Set.Ici (0 : ℝ), h x) + ∫⁻ x in (Set.Ici (0 : ℝ))ᶜ, h x := fun h =>
    (lintegral_add_compl h measurableSet_Ici).symm
  have htot : ∫⁻ x, V x ^ p ≤ K ^ p * ∫⁻ x, ‖f x‖ₑ ^ p := by
    rw [hsplit (fun x => V x ^ p), hsplit (fun x => ‖f x‖ₑ ^ p), mul_add]
    exact add_le_add hA' hB'
  have h3 := ENNReal.rpow_le_rpow htot (show 0 ≤ 1 / p by positivity)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hp0.ne',
    ENNReal.rpow_one] at h3
  exact h3

end Final

end PrimeCarleson.Proof.Lepingle
